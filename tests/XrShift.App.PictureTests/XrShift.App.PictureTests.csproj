<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The app's own framework, so the app can be built first and Windows' picture classes read the PNGs. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only to build XrShift.exe before the tests: they run it as a program, as a person would. -->
    <ProjectReference Include="..\..\src\XrShift.App\XrShift.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
